# Optional container configuration. Copy to .env and adjust.
TZ=Asia/Shanghai

# 管理员账号（首次安装也可在网页设置）
STREAMPULSE_USERNAME=admin
# 密码留空 = 首次访问网页时创建账号和密码
STREAMPULSE_PASSWORD=

# Emby 访问的 302 地址；留空会按浏览器访问地址自动推断
# 例如：STREAM_PUBLIC_URL=http://192.168.1.10:2048
STREAM_PUBLIC_URL=

# 三个目录分别映射：配置 / STRM / 日志
# 如需直接写入媒体目录，修改 compose 挂载并把 OUTPUT_DIR 指向容器内路径
CONFIG_DIR=/config
OUTPUT_DIR=/strm
LOG_DIR=/logs
LOG_RETENTION_DAYS=14

TRUST_PROXY=false
