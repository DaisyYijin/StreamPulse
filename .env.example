# 复制为 .env 后修改
AUTH_USER=admin
AUTH_PASSWORD=change-me

# 播放器访问到的宿主机地址（端口要与 STREAM_PORT 的外部映射一致）
PUBLIC_BASE=http://192.168.1.10:6086

# STRM 输出目录（宿主机路径；Emby 必须挂载同一目录）
MEDIA_DIR=/vol1/1000/Media

# redirect = 302 直链；proxy = 本机中转
PLAY_MODE=redirect

# 115 开放平台（可选；不填则只用扫码 Cookie）
P115_APP_ID=
P115_APP_SECRET=

# 115 读写节流
P115_READ_INTERVAL_MS=1000
P115_WRITE_INTERVAL_MS=3000

# 生活事件增量
INCR_ENABLED=true
INCR_INTERVAL_MS=30000

# Emby
EMBY_BASE=http://192.168.1.10:8096
EMBY_API_KEY=
EMBY_DELETE_REMOTE=false
EMBY_WEBHOOK_TOKEN=

# 对外端口
WEB_PORT=6060
STREAM_PORT=6086
